[Unit]
Description=Select Intel CPU and GPU policies from the power source
Wants=upower.service power-profiles-daemon.service
After=upower.service power-profiles-daemon.service

[Service]
Type=exec
ExecStart=/usr/local/libexec/power-toggle-hardware monitor
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=graphical.target
